<Window x:Class="InkCanvasForPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ink="clr-namespace:InkCanvasForPDF.Controls"
        xmlns:board="clr-namespace:InkCanvasForPDF.Board"
        xmlns:conv="clr-namespace:InkCanvasForPDF.Converters"
        Title="{Binding WindowTitle}"
        Width="1100" Height="760"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.IsBackButtonVisible="False"
        ui:TitleBar.IsIconVisible="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:BoolToBitmapScalingModeConverter x:Key="ZoomScalingMode"/>

        <!-- 轻量图标按钮：Fluent 图标 + 透明圆角悬停，非正经 Fluent 按钮。
             FontSize 作为图标继承兜底（FluentIcon 为 TextBlock 子类，显式 FontSize 必然生效）。 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶级菜单项（"文件"下拉）：保留 PART_Popup 以展开子菜单，高亮背景 #F6F6F6 -->
        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Margin="1" Padding="8,5" CornerRadius="6"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   VerticalOffset="16" PopupAnimation="None"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False">
                                <Border x:Name="DropPanel" MinWidth="175" Padding="0,3"
                                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" SnapsToDevicePixels="True">
                                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                    <ScrollViewer Margin="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DropPanel"
                                                             Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                                             From="-90" To="0" Duration="00:00:00.167">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 子菜单项：wpfui SubmenuItem 风格（圆角高亮小块 + 图标/文字靠左） -->
        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Margin="4,1,4,1" Background="Transparent" CornerRadius="4">
                            <Grid Margin="8,6,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" Grid.Column="0" Margin="0,0,6,0"
                                                  VerticalAlignment="Center" ContentSource="Icon"/>
                                <ContentPresenter x:Name="Header" Grid.Column="1"
                                                  ContentSource="Header" RecognizesAccessKey="True"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                        </Trigger>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页码输入框：常驻轻量输入框（浅灰描边、居中、无清除按钮/无标题），直接可编辑 -->
        <Style x:Key="PageNumberBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 墨迹撤销/重做快捷键：Ctrl+Z 撤销，Ctrl+Y 重做（工具栏仅 4 按钮，重做无按钮） -->
    <Window.InputBindings>
        <KeyBinding Command="{Binding InkTool.UndoCommand}" Key="Z" Modifiers="Control"/>
        <KeyBinding Command="{Binding InkTool.RedoCommand}" Key="Y" Modifiers="Control"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ 顶部工具栏（打开 PDF 且未打开设置时显示）═══ -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6"
                Visibility="{Binding IsToolbarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：缩略图开关 + 文件菜单 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Margin="0,0,0,0" Click="ThumbnailPanelToggle_Click" ToolTip="打开/关闭缩略图">
                        <Grid Width="32" Height="32">
                            <ic:FluentIcon Icon="List" IconVariant="Regular" FontSize="24"
                                           Foreground="{DynamicResource ToolbarForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Menu VerticalAlignment="Center" Margin="8,0,0,0">
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ic:FluentIcon Icon="Document" IconVariant="Regular" FontSize="20" Foreground="{DynamicResource ToolbarForegroundBrush}"/>
                                    <TextBlock Text="文件" FontSize="16" Foreground="{DynamicResource ToolbarForegroundBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="14" Foreground="{DynamicResource ToolbarForegroundBrush}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}" Header="打开 PDF" Command="{Binding OpenPdfCommand}">
                                <MenuItem.Icon>
                                    <ic:FluentIcon Icon="DocumentAdd" IconVariant="Regular" FontSize="24"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}" Header="回到主页" Command="{Binding GoHomeCommand}">
                                <MenuItem.Icon>
                                    <ic:FluentIcon Icon="Home" IconVariant="Regular" FontSize="24"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}" Header="打开设置" Command="{Binding OpenSettingsCommand}">
                                <MenuItem.Icon>
                                    <ic:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="24"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- 中：页码控件（- [页码输入框] / 总页数 +，常驻输入框可直接编辑跳页） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding GoToPreviousPageCommand}" ToolTip="上一页">
                        <Grid Width="32" Height="32">
                            <ic:FluentIcon Icon="ChevronLeft" IconVariant="Regular" FontSize="24"
                                           Foreground="{DynamicResource ToolbarForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <!-- 页码输入框：常驻、居中、宽度随文本自适应（Enter/失焦提交跳页，单击光标跳最右） -->
                    <TextBox x:Name="PageNumberBox" Style="{StaticResource PageNumberBoxStyle}" Margin="8,0,0,0"
                             Text="{Binding PageNumberText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="PageNumberBox_KeyDown" LostFocus="PageNumberBox_LostFocus"
                             PreviewMouseLeftButtonDown="PageNumberBox_PreviewMouseLeftButtonDown"/>
                    <TextBlock Text="/" FontSize="14" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock Text="{Binding TotalPages}" FontSize="14" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding GoToNextPageCommand}" ToolTip="下一页">
                        <Grid Width="32" Height="32">
                            <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="24"
                                           Foreground="{DynamicResource ToolbarForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 右：缩放 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="ZoomOutButton_Click" ToolTip="缩小">
                        <Grid Width="32" Height="32">
                            <ic:FluentIcon Icon="Subtract" IconVariant="Regular" FontSize="24"
                                           Foreground="{DynamicResource ToolbarForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="ZoomInButton_Click" ToolTip="放大">
                        <Grid Width="32" Height="32">
                            <ic:FluentIcon Icon="Add" IconVariant="Regular" FontSize="24"
                                           Foreground="{DynamicResource ToolbarForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区：缩略图面板 + 页面（打开 PDF 期间整体 Opacity=0 隐藏，让加载页呈现纯云母） -->
        <Grid x:Name="ContentAreaGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 缩略图侧栏 -->
            <Grid Grid.Column="0" ClipToBounds="True"
                  Visibility="{Binding IsThumbnailPanelVisible, Converter={StaticResource BoolToVisibility}}"
                  IsVisibleChanged="ThumbnailPanel_IsVisibleChanged">
                <!-- 整个半透明白色容器（背景+边框+列表）作为滑入动画对象；ClipToBounds 裁剪滑出列宽的部分 -->
                <Grid x:Name="ThumbnailPanelHost" Width="200" Background="{DynamicResource ThumbnailPanelTranslucentBrush}" RenderTransformOrigin="0,0.5">
                    <Border BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,1,0">
                        <ListBox x:Name="ThumbnailList"
                                 Margin="8"
                                 ItemsSource="{Binding Thumbnails}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Loaded="ThumbnailList_Loaded"
                                 IsVisibleChanged="ThumbnailList_IsVisibleChanged"
                                 SizeChanged="ThumbnailList_SizeChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.CacheLength="2"
                                 VirtualizingPanel.CacheLengthUnit="Item"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Thumbnail_Click" Cursor="Hand" Margin="0,0,0,10"
                                            HorizontalAlignment="Center"
                                            Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <!-- Grid 两层：底层白底+图片（Clip 圆角由 SizeChanged 设置），覆盖层蓝框描边在图片之上（子元素会压住 Border 描边，故拆层保证 z 序） -->
                                            <Grid>
                                                <Border Padding="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                                                        SizeChanged="ThumbnailFrame_SizeChanged">
                                                    <Image Source="{Binding Image}"
                                                           Width="{Binding Width}"
                                                           Height="{Binding Height}"
                                                           Stretch="None"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <Border CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding PageNumber}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- 页面区 -->
            <Grid Grid.Column="1">
                <!-- PDF 页面（打开后显示）：KillerPDF 式布局——纯 ScrollViewer + 居中页槽（ItemsControl/StackPanel），
                     逐页 LayoutTransform 缩放 + WidthScale 宽度补偿；无 ListBox 虚拟化（页槽常驻，位图级释放）。
                     PanningMode=None：内置触摸平移不看手指数（单指会抢书写、换指瞬间质心跳变会跳视图），
                     平移/缩放/惯性由 MainWindow.xaml.cs 的 PagesControl_Manipulation* 按手指数门控接管。 -->
                <ScrollViewer x:Name="PagesScrollViewer"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              IsManipulationEnabled="True"
                              PanningMode="None"
                              FocusVisualStyle="{x:Null}"
                              Loaded="PagesControl_Loaded"
                              SizeChanged="ScrollViewer_SizeChanged"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                              ScrollChanged="ScrollViewer_ScrollChanged"
                              Visibility="{Binding HasPdf, Converter={StaticResource BoolToVisibility}}">
                    <Border Padding="12" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                            <!-- 整层等比缩放（槽位固定）：DisplayScale = 用户缩放 × 宽度适配。
                                 页面尺寸固定不重建 → 宽度变化无占位闪动 -->
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
                            </Grid.LayoutTransform>
                        <ItemsControl x:Name="PagesItemsControl" ItemsSource="{Binding Pages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" HorizontalAlignment="Center"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <!-- 叠加画布：Grid 内 Image 下层 + InkCanvas 上层（参考 PdfTeachAnnotator；
                                             同尺寸同页面坐标，随整层 DisplayScale 缩放保持与位图对齐） -->
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <Image Source="{Binding Image}"
                                                   Width="{Binding Width}"
                                                   Height="{Binding Height}"
                                                   Stretch="None"
                                                   RenderOptions.BitmapScalingMode="{Binding DataContext.IsZooming, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ZoomScalingMode}}"/>
                                            <!-- PageInkCanvas = InkCanvas 子类：构造函数内替换为时间笔锋的自定义 DynamicRenderer（该属性为 protected，无法外部替换） -->
                                            <ink:PageInkCanvas Strokes="{Binding Strokes}"
                                                       Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Background="Transparent"
                                                       Cursor="Pen"
                                                       Focusable="False"
                                                       IsHitTestVisible="{Binding DataContext.InkTool.IsInkMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       EditingMode="{Binding DataContext.InkTool.EditingMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       DefaultDrawingAttributes="{Binding DataContext.InkTool.DrawingAttributes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       ForceCursor="{Binding DataContext.InkTool.ForceCursor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Loaded="InkCanvas_Loaded"
                                                       Unloaded="InkCanvas_Unloaded"
                                                       StrokeCollected="PageInkCanvas_StrokeCollected"
                                                       SelectionChanged="PageInkCanvas_SelectionChanged"
                                                       PreviewMouseDown="InkCanvas_PreviewMouseDown"
                                                       PreviewMouseUp="InkCanvas_PreviewMouseUp"
                                                       TouchUp="InkCanvas_TouchUp"
                                                       MouseDown="PageCanvas_ShapeMouseDown"
                                                       MouseMove="PageCanvas_ShapeMouseMove"
                                                       MouseUp="PageCanvas_ShapeMouseUp"
                                                       TouchDown="PageCanvas_ShapeTouchDown"
                                                       TouchMove="PageCanvas_ShapeTouchMove"
                                                       PreviewTouchUp="PageCanvas_ShapePreviewTouchUp">
                                                <!-- Cursor="Pen" 对齐 ICA：批注显钢笔；ForceCursor 仅"开显示画笔光标 + 批注模式"时强制（关=回到 InkCanvas 默认，即钢笔）；橡皮显示自定义黑板擦光标（UseCustomCursor，宽=EraserSize） -->
                                                <!-- TouchUp 对齐画板 Main_Grid_TouchUp：触摸/手写笔抬手显式提交擦除批处理（提升的 MouseUp 时机不可靠） -->
                                            </ink:PageInkCanvas>
                                            <!-- 选择遮罩（ICA 屏幕批注 MainWindow.xaml L100-113 逐字复制）：
                                                 有选区时覆盖页面拦截鼠标/触摸做拖移与双指变换，显隐由代码后置驱动 -->
                                            <Grid
                                                Name="GridInkCanvasSelectionCover"
                                                Background="#01FFFFFF"
                                                IsManipulationEnabled="True"
                                                ManipulationCompleted="GridInkCanvasSelectionCover_ManipulationCompleted"
                                                ManipulationDelta="GridInkCanvasSelectionCover_ManipulationDelta"
                                                ManipulationStarting="GridInkCanvasSelectionCover_ManipulationStarting"
                                                MouseDown="GridInkCanvasSelectionCover_MouseDown"
                                                MouseMove="GridInkCanvasSelectionCover_MouseMove"
                                                MouseUp="GridInkCanvasSelectionCover_MouseUp"
                                                Opacity="0.01"
                                                PreviewTouchDown="GridInkCanvasSelectionCover_PreviewTouchDown"
                                                PreviewTouchUp="GridInkCanvasSelectionCover_PreviewTouchUp"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- 空态：欢迎 + 打开PDF/打开设置（未打开时显示） -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Orientation="Vertical"
                            Visibility="{Binding HasPdf, Converter={StaticResource InverseBoolToVisibility}}">

                    <!-- 欢迎语，居中 -->
                    <TextBlock Text="欢迎"
                               FontSize="40" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ToolbarForegroundBrush}"
                               Margin="0,0,0,24"/>

                    <!-- 两个正方形按钮：图标在上、文字在下 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Command="{Binding OpenPdfCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ui:ControlHelper.CornerRadius="8"
                                Width="150" Height="150"
                                Padding="0" FontSize="16" Cursor="Hand">
                            <StackPanel Orientation="Vertical">
                                <ic:FluentIcon Icon="DocumentAdd" IconVariant="Regular" FontSize="48"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="打开 PDF" FontSize="16" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenSettingsCommand}"
                                ui:ControlHelper.CornerRadius="8"
                                Width="150" Height="150"
                                Padding="0" FontSize="16" Cursor="Hand"
                                Margin="16,0,0,0">
                            <StackPanel Orientation="Vertical">
                                <ic:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="48"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="打开设置" FontSize="16" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>

                <!-- 设置覆盖层：显隐由 MainWindow 滑入/滑出动画控制 -->
            </Grid>
        </Grid>

        <!-- 加载页：打开 PDF 期间全透明呈现纯云母（Transparent 背景仍拦截输入；
             下方内容由 ApplyOpeningBackdrop 置 Opacity=0 隐藏，绝不透出欢迎页/旧 PDF）；
             ZIndex 45 = 低于画板(50)、高于设置(40) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="45"
              Background="Transparent"
              Visibility="{Binding IsOpeningPdf, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" IsIndeterminate="True"
                                 Width="64" Height="64" HorizontalAlignment="Center"/>
                <TextBlock Text="正在打开" FontSize="18"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 设置覆盖层：外层 Grid 跨 Row0+Row1（含顶栏区域），ZIndex 低于画板(50)高于内容/墨迹栏(10)，
             退出时顶栏在面板下方恢复，不会把滑出面板"挤"到工具栏下 -->
        <ink:SettingsView x:Name="SettingsView" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="40"
                          DataContext="{Binding}"
                          Visibility="Collapsed"/>

        <!-- 墨迹浮动栏：宿主铺满整窗（跨 Row0+Row1），内部 Viewbox 位置由代码按缩放/边距设置计算 Margin 驱动 -->
        <ink:InkToolBar x:Name="InkBar" Grid.Row="0" Grid.RowSpan="2"
                        Panel.ZIndex="10"
                        Visibility="{Binding HasPdf, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 选择浮动工具栏（ICA 屏幕批注 MainWindow.xaml L114-612 逐字复制）：
             窗口级承载（不进页面模板）——页面 Grid 处于 DisplayScale 缩放层内，页内放置会随缩放变形；
             窗口级尺寸恒定，与 ICA 观感一致。显隐与 Margin 由代码后置按选区驱动，仅作用于有选区的那一页 -->
        <Border x:Name="BorderStrokeSelectionControl"
                Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="12"
                Height="80"
                Margin="0,65,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource FloatBarBackground}"
                BorderBrush="{DynamicResource FloatBarBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="Collapsed">
                <Viewbox>
                    <ikw:SimpleStackPanel Height="80" Orientation="Horizontal" Spacing="6">
                        <ikw:SimpleStackPanel Margin="4,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <Border CornerRadius="5">
                                <ToggleButton x:Name="ToggleButtonStrokeSelectionClone"
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Checked="BorderStrokeSelectionClone_Click"
                                    IsChecked="False"
                                    Unchecked="BorderStrokeSelectionClone_Click">
                                    <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                        <ui:FontIcon x:Name="IconStrokeSelectionClone"
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe8c8;" />
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{Binding ElementName=IconStrokeSelectionClone, Path=Foreground}" Text="克隆模式" />
                                    </ikw:SimpleStackPanel>
                                </ToggleButton>
                            </Border>
                            <Button
                                Width="90"
                                Height="35"
                                Padding="0"
                                Background="{DynamicResource FloatBarBackground}"
                                Click="BorderStrokeSelectionCloneToBoardOrNewPage_Click">
                                <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="16"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="&#xf413;" />
                                    <TextBlock x:Name="TextSelectionCloneToNewBoard"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="衍至画板" />
                                </ikw:SimpleStackPanel>
                            </Button>
                        </ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="4">
                            <Border Height="33" Padding="5,0" Background="{DynamicResource FloatBarBackground}" CornerRadius="3">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="&#xe7ad;">
                                        <ui:FontIcon.RenderTransformOrigin>
                                            <Point X="0.5" Y="0.5" />
                                        </ui:FontIcon.RenderTransformOrigin>
                                        <ui:FontIcon.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="90" />
                                                <ScaleTransform ScaleX="1" ScaleY="-1" />
                                            </TransformGroup>
                                        </ui:FontIcon.RenderTransform>
                                    </ui:FontIcon>
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="逆旋" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnAnticlockwiseRotate15_Click">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="15°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnAnticlockwiseRotate45_Click">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="45°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnAnticlockwiseRotate90_Click">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="90°" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                            <Border Height="33" Padding="5,0" Background="{DynamicResource FloatBarBackground}" CornerRadius="3">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="&#xe7ad;">
                                        <ui:FontIcon.RenderTransformOrigin>
                                            <Point X="0.5" Y="0.5" />
                                        </ui:FontIcon.RenderTransformOrigin>
                                        <ui:FontIcon.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </ui:FontIcon.RenderTransform>
                                    </ui:FontIcon>
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="顺旋" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnClockwiseRotate15_Click">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="15°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnClockwiseRotate45_Click">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="45°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnClockwiseRotate90_Click">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="90°" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                        </ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="2">
                            <Button
                                Width="90"
                                Height="35"
                                Padding="0"
                                Background="{DynamicResource FloatBarBackground}"
                                Click="BtnFlipHorizontal_Click">
                                <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                    <ikw:SimpleStackPanel Width="18" Height="18" Orientation="Vertical">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe71a;" />
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-18,-1,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xf464;" />
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-17,0,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="12"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe80c;">
                                            <ui:FontIcon.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5" />
                                            </ui:FontIcon.RenderTransformOrigin>
                                            <ui:FontIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                                </TransformGroup>
                                            </ui:FontIcon.RenderTransform>
                                        </ui:FontIcon>
                                    </ikw:SimpleStackPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="水平翻转" />
                                </ikw:SimpleStackPanel>
                            </Button>
                            <Button
                                Width="90"
                                Height="35"
                                Padding="0"
                                Background="{DynamicResource FloatBarBackground}"
                                Click="BtnFlipVertical_Click">
                                <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                    <ikw:SimpleStackPanel Width="18" Height="18" Orientation="Vertical">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe71a;" />
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-19,0,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xf464;">
                                            <ui:FontIcon.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5" />
                                            </ui:FontIcon.RenderTransformOrigin>
                                            <ui:FontIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                                </TransformGroup>
                                            </ui:FontIcon.RenderTransform>
                                        </ui:FontIcon>
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-18,0,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="12"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe80c;" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="竖直翻转" />
                                </ikw:SimpleStackPanel>
                            </Button>
                        </ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel Margin="0,0,4,0" VerticalAlignment="Center" Spacing="4">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                <Border
                                    Width="155"
                                    Height="33"
                                    Padding="5,0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource FloatBarBackground}"
                                    CornerRadius="3">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe70f;" />
                                        <TextBlock
                                            Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="粗细" />
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="GridPenWidthIncrease_Click">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Glyph="&#xe948;" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="GridPenWidthDecrease_Click">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Glyph="&#xe949;" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="GridPenWidthRestore_Click">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Glyph="&#xe72c;" />
                                        </Button>
                                    </ikw:SimpleStackPanel>
                                </Border>
                                <Button
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Click="BtnStrokeSelectionSaveToImage_Click">
                                    <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xee71;" />
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="存为图片" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                                <Button
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Click="BorderStrokeSelectionDelete_Click">
                                    <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe74d;" />
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="删除" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                            </ikw:SimpleStackPanel>
                            <Border Height="33" Padding="5,0" Background="{DynamicResource FloatBarBackground}" CornerRadius="3">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="&#xe790;" />
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="颜色" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorBlack_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="Black"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorWhite_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="White"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorRed_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#dc2626"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorOrange_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#ea580c"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorYellow_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#eab308"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorGreen_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#16a34a"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorTeal_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#0d9488"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorBlue_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#2563eb"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorPink_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#c72ec7"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                        </ikw:SimpleStackPanel>
                    </ikw:SimpleStackPanel>
                </Viewbox>
        </Border>

        <!-- 画板（移植 Ink-Canvas-Artistry 4.9.4）：顶到标题栏，覆盖顶部工具栏与内容区；
             进入画板模式后墨迹栏被覆盖不可见；退出后还原 -->
        <board:BoardView x:Name="Board" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50" Visibility="Collapsed"/>

        <!-- 浮动通知容器（IUWM InfoBar）：中下侧悬浮于内容之上，长按保持选中图形等提示用；
             通知项由代码后置创建（ShowFloatingTip），新通知插到最上（旧通知下方堆叠），3 秒滑动消失 -->
        <StackPanel
            x:Name="FloatingTipPanel"
            Grid.Row="0" Grid.RowSpan="2"
            Panel.ZIndex="60"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,64" />
    </Grid>
</Window>
