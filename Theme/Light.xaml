<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题（App 级语义画刷；值取自原硬编码 + ICA Light.xaml 的 FloatBar*）。
         由 ThemeService 在 Application.Resources.MergedDictionaries 中与 Dark.xaml 二选一。 -->

    <!-- 应用语义画刷 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DCDCE0"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#666666"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>

    <!-- 墨迹浮动栏画刷（浅色值 = 原 InkToolBar.xaml 本地定义） -->
    <SolidColorBrush x:Key="FloatBarBackground" Opacity="0.75" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="FloatBarBackgroundWithoutOpacity" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="FloatBarBorderBrush" Opacity="0.8" Color="Black"/>
    <!-- 主题色按钮专用描边（浅灰，区别于共用的 FloatBarBorderBrush 近黑） -->
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#D4D4D4"/>
    <!-- 主题色按钮专用底色（深色非纯黑） -->
    <SolidColorBrush x:Key="AccentButtonBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="FloatBarForeground" Color="Black"/>
    <!-- 墨迹栏图标/文字专用（弹窗内部仍用 FloatBarForeground）；彩色渐变背景时代码后置覆盖为黑色 -->
    <SolidColorBrush x:Key="FloatBarIconForeground" Color="Black"/>
    <Color x:Key="FloatBarForegroundColor">#FF666666</Color>
    <Color x:Key="FloatBarButtonBackgroundKey">Transparent</Color>
    <Color x:Key="FloatBarButtonBackgroundPointerOverKey">#66FFFFFF</Color>
    <Color x:Key="FloatBarButtonButtonBackgroundPressedKey">#99FFFFFF</Color>
</ResourceDictionary>
