<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题（App 级语义画刷；FloatBar* 深色值抄 ICA Dark.xaml）。
         由 ThemeService 在 Application.Resources.MergedDictionaries 中与 Light.xaml 二选一。 -->

    <!-- 应用语义画刷 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252525"/>
    <!-- 缩略图侧栏半透明深底：透出窗口云母背景（磨砂侧栏效果） -->
    <SolidColorBrush x:Key="ThumbnailPanelTranslucentBrush" Color="#CC252525"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#999999"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB0"/>

    <!-- 墨迹浮动栏画刷（抄 ICA Resources/Styles/Dark.xaml） -->
    <SolidColorBrush x:Key="FloatBarBackground" Opacity="0.6" Color="Black"/>
    <SolidColorBrush x:Key="FloatBarBackgroundWithoutOpacity" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="FloatBarBorderBrush" Opacity="0.6" Color="White"/>
    <!-- 主题色按钮专用描边（中灰，深底可见） -->
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#555555"/>
    <!-- 主题色按钮专用底色（非纯黑，对齐目标图） -->
    <SolidColorBrush x:Key="AccentButtonBackgroundBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="FloatBarForeground" Color="White"/>
    <!-- 墨迹栏图标/文字专用（弹窗内部仍用 FloatBarForeground）；彩色渐变背景时代码后置覆盖为黑色 -->
    <SolidColorBrush x:Key="FloatBarIconForeground" Color="White"/>
    <Color x:Key="FloatBarForegroundColor">#FFcccccc</Color>
    <Color x:Key="FloatBarButtonBackgroundKey">Transparent</Color>
    <Color x:Key="FloatBarButtonBackgroundPointerOverKey">#22FFFFFF</Color>
    <Color x:Key="FloatBarButtonButtonBackgroundPressedKey">#44FFFFFF</Color>
</ResourceDictionary>
