                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorTeal_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorTealSoftContent" Margin="8" Visibility="Collapsed">
                                                                <Image
