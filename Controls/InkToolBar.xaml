<UserControl x:Class="InkCanvasForPDF.Controls.InkToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <UserControl.Resources>
        <!-- 显式 ResourceDictionary：合并形状图标字典 + 保留本地键 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 形状面板图标（DrawShapeImageSource.*）：与画板同字典 -->
                <ResourceDictionary Source="pack://application:,,,/Board/Resources/DrawShapeImageDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:ElementTheme x:Key="FloatTheme">Light</ui:ElementTheme>
            <ui:ElementTheme x:Key="BoardTheme">Light</ui:ElementTheme>
            <!-- FloatBar*/BoardBar* 画刷已迁至 App 级 Theme/Light.xaml 与 Theme/Dark.xaml（ThemeService 切换），此处不再本地定义 -->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Viewbox
            Name="ViewboxFloatingBar"
            Height="50"
            Margin="100,0,-2000,-200"
            HorizontalAlignment="Left" VerticalAlignment="Top">
            <Viewbox.LayoutTransform>
                <ScaleTransform x:Name="ViewboxFloatingBarScaleTransform" ScaleX="1" ScaleY="1" />
            </Viewbox.LayoutTransform>
            <ikw:SimpleStackPanel Orientation="Horizontal">

                <ikw:SimpleStackPanel.Resources>
                    <!--  定义 SolidColorBrush 资源  -->
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundKey}" Color="{DynamicResource FloatBarButtonBackgroundKey}" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}" Color="{DynamicResource FloatBarButtonBackgroundPointerOverKey}" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}" Color="{DynamicResource FloatBarButtonButtonBackgroundPressedKey}" />
                    <!--  定义按钮样式  -->
                    <Style x:Key="FloatBarButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundKey}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ikw:SimpleStackPanel.Resources>
                <Border
                    Name="BorderFloatingBarMainControls"
                    Height="36"
                    Margin="2,0,0,0"
                    Padding="1"
                    Background="{DynamicResource FloatBarBackground}"
                    BorderBrush="{DynamicResource FloatBarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Visible">
                    <ikw:SimpleStackPanel Name="StackPanelFloatingBar" Orientation="Horizontal">
                        <Button x:Name="BtnMouse"
                            Width="30"
                            Height="32"
                            Padding="0"
                            BorderThickness="0"
                            Click="CursorIcon_Click"
                            MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <Border x:Name="MouseCheckBorder" Width="30" Height="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="5" Background="Transparent" Opacity="1">
                                <Grid>
                                    <Border x:Name="MouseHoverOverlay" Background="Transparent" Visibility="Collapsed" CornerRadius="5" />
                                    <ikw:SimpleStackPanel Name="Mouse_Icon" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Orientation="Vertical">
                                        <ui:FontIcon x:Name="Icon_Mouse"
                                                Width="30"
                                                Height="22"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="16"
                                                Foreground="{DynamicResource FloatBarIconForeground}"
                                                Glyph="&#xe8b0;" />
                                        <TextBlock x:Name="FloatBarSelectIconTextBlock"
                                            Visibility="Collapsed"
                                            Margin="1,-1,0,0"
                                            FontSize="8"
                                            Foreground="{DynamicResource FloatBarIconForeground}"
                                            Text="鼠标"
                                            TextAlignment="Center" />
                                    </ikw:SimpleStackPanel>
                                    <Border x:Name="MouseAccentPill" Width="13" Height="3" CornerRadius="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                        Background="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Button>
                        <Button x:Name="BtnPen"
                            Width="30"
                            Height="32"
                            Margin="2,0,0,0"
                            Padding="0"
                            BorderThickness="0"
                            Click="PenIcon_Click"
                            MouseEnter="ToolButton_MouseEnter" MouseLeave="ToolButton_MouseLeave">
                            <Border x:Name="PenCheckBorder" Width="30" Height="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="5" Background="Transparent" Opacity="1">
                                <Grid>
                                    <Border x:Name="PenHoverOverlay" Background="Transparent" Visibility="Collapsed" CornerRadius="5" />
                                    <ikw:SimpleStackPanel
                                        Name="Pen_Icon"
                                        Width="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Orientation="Vertical">
                                        <ui:FontIcon x:Name="Icon_Pen"
                                            Width="30"
                                            Height="22"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarIconForeground}"
                                            Glyph="&#xee56;" />
                                        <TextBlock
                                            Margin="1,-1,0,0"
                                            FontSize="8"
                                            Foreground="{DynamicResource FloatBarIconForeground}"
                                            Text="墨迹"
                                            TextAlignment="Center"
                                            Visibility="{Binding ElementName=FloatBarSelectIconTextBlock, Path=Visibility}" />
                                    </ikw:SimpleStackPanel>
                                    <Border x:Name="PenAccentPill" Width="13" Height="3" CornerRadius="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                        Background="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Button>
                        <ikw:SimpleStackPanel Name="StackPanelCanvasControls" Orientation="{Binding ElementName=StackPanelFloatingBar, Path=Orientation}" Visibility="Visible">
                            <!--  图形入口按钮 + 形状面板（ICA 浮动栏 ImageDrawShape_Click 入口 + BorderDrawShape 面板移植，样式一致，初始隐藏）  -->
                            <!--  墨迹选项弹窗（照 ICA PenPalette：Popup + Custom 放置，PlacementTarget=墨迹按钮，见代码后置回调）  -->
                            <Popup x:Name="PenPalette"
                                Placement="Custom"
                                AllowsTransparency="True"
                                StaysOpen="True"
                                IsOpen="False"
                                PopupAnimation="None">
                                <Border x:Name="PenPaletteRoot"
                                    Background="{DynamicResource FloatBarBackgroundWithoutOpacity}"
                                    BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10">
                                    <Border.Resources>
                                        <!--  紧凑 Pivot：复用 IUWM 的字号资源键与 TabItemPivot 样式基类（须先于 TabControl 声明，StaticResource 不支持前向引用）  -->
                                        <sys:Double x:Key="PivotHeaderItemFontSize">18</sys:Double>
                                        <Style x:Key="InkPivotTabItem" TargetType="TabItem"
                                            BasedOn="{StaticResource {x:Static ui:ThemeKeys.TabItemPivotStyleKey}}">
                                            <Setter Property="Height" Value="36" />
                                        </Style>
                                    </Border.Resources>
                                    <TabControl x:Name="PivotInk"
                                        Style="{StaticResource TabControlPivotStyle}"
                                        ItemContainerStyle="{StaticResource InkPivotTabItem}">
                                        <TabItem Header="硬笔">
                                            <ikw:SimpleStackPanel Margin="12,2,12,12" Spacing="8">
                                                <!-- 行1：多指书写 + 抬笔纠正（笔锋下拉已移至设置页；三页签统一居中；荧光笔页签无抬笔纠正） -->
                                                <!-- 两个开关均不显示 开/关 文字（置空内容，避免回落 iNKORE 默认的 On/Off） -->
                                                <ikw:SimpleStackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="多指书写" />
                                                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableMultiFingerInkHard"
                                                        MinWidth="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="ToggleSwitchEnableMultiFingerInk_Toggled" />
                                                    <TextBlock Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="抬笔纠正" />
                                                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableInkToShapeHard"
                                                        MinWidth="0"
                                                        IsOn="True"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="ToggleSwitchEnableInkToShape_Toggled" />
                                                </ikw:SimpleStackPanel>
                                                <!-- 行2：粗细 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="粗细" />
                                                    <Slider x:Name="InkWidthSliderHard"
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        IsSnapToTickEnabled="True"
                                                        Maximum="30"
                                                        Minimum="1"
                                                        TickFrequency="1"
                                                        TickPlacement="None"
                                                        ValueChanged="InkWidthSlider_ValueChanged"
                                                        Value="5"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="{Binding Value, ElementName=InkWidthSliderHard, Mode=OneWay}" />
                                                </Grid>
                                                <!-- 行3：9 色调色盘 + 亮/暗系切换（沿用原版色块样式） -->
                                                <Controls:UniformGrid Rows="2" Columns="5" HorizontalAlignment="Center">
                                                        <Border
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="ColorThemeSwitch_MouseUp">
                                                            <Grid Margin="5">
                                                                <ui:FontIcon x:Name="ColorThemeSwitchIconHard"
                                                                    Width="26"
                                                                    Height="26"
                                                                    VerticalAlignment="Top"
                                                                    FontFamily="{StaticResource FluentIconFontFamily}"
                                                                    Foreground="{DynamicResource FloatBarForeground}"
                                                                    Glyph="&#xe706;" />
                                                                <TextBlock x:Name="ColorThemeSwitchTextBlockHard"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Bottom"
                                                                    FontSize="13"
                                                                    Foreground="{DynamicResource FloatBarForeground}"
                                                                    Text="亮系" />
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorBlackHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="Black"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorBlack_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorBlackHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorWhiteHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="White"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorWhite_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorWhiteHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-black.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorRedHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#dc2626"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorRed_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorRedHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorPinkHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#c72ec7"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorPink_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorPinkHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorOrangeHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#ea580c"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorOrange_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorOrangeHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorYellowHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#eab308"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorYellow_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorYellowHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorGreenHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#16a34a"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorGreen_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorGreenHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorTealHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#0d9488"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorTeal_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorTealHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorBlueHard"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#2563eb"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorBlue_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorBlueHardContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                    </Controls:UniformGrid>
                                            </ikw:SimpleStackPanel>
                                        </TabItem>
                                        <TabItem Header="软笔">
                                            <ikw:SimpleStackPanel Margin="12,2,12,12" Spacing="8">
                                                <!-- 行1：多指书写 + 抬笔纠正（软笔=开压感；三页签统一居中） -->
                                                <!-- 两个开关均不显示 开/关 文字（置空内容，避免回落 iNKORE 默认的 On/Off） -->
                                                <ikw:SimpleStackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="多指书写" />
                                                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableMultiFingerInkSoft"
                                                        MinWidth="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="ToggleSwitchEnableMultiFingerInk_Toggled" />
                                                    <TextBlock Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="抬笔纠正" />
                                                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableInkToShapeSoft"
                                                        MinWidth="0"
                                                        IsOn="True"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="ToggleSwitchEnableInkToShape_Toggled" />
                                                </ikw:SimpleStackPanel>
                                                <!-- 行2：粗细 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="粗细" />
                                                    <Slider x:Name="InkWidthSliderSoft"
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        IsSnapToTickEnabled="True"
                                                        Maximum="30"
                                                        Minimum="1"
                                                        TickFrequency="1"
                                                        TickPlacement="None"
                                                        ValueChanged="InkWidthSlider_ValueChanged"
                                                        Value="5"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="{Binding Value, ElementName=InkWidthSliderSoft, Mode=OneWay}" />
                                                </Grid>
                                                <!-- 行3：9 色调色盘 + 亮/暗系切换（沿用原版色块样式） -->
                                                <Controls:UniformGrid Rows="2" Columns="5" HorizontalAlignment="Center">
                                                        <Border
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="ColorThemeSwitch_MouseUp">
                                                            <Grid Margin="5">
                                                                <ui:FontIcon x:Name="ColorThemeSwitchIconSoft"
                                                                    Width="26"
                                                                    Height="26"
                                                                    VerticalAlignment="Top"
                                                                    FontFamily="{StaticResource FluentIconFontFamily}"
                                                                    Foreground="{DynamicResource FloatBarForeground}"
                                                                    Glyph="&#xe706;" />
                                                                <TextBlock x:Name="ColorThemeSwitchTextBlockSoft"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Bottom"
                                                                    FontSize="13"
                                                                    Foreground="{DynamicResource FloatBarForeground}"
                                                                    Text="亮系" />
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorBlackSoft"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="Black"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorBlack_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorBlackSoftContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorWhiteSoft"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="White"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorWhite_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorWhiteSoftContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-black.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorRedSoft"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#dc2626"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorRed_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorRedSoftContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorPinkSoft"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#c72ec7"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorPink_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorPinkSoftContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Top"
                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                    Source="/Resources/Icons-png/checked-white.png" />
                                                            </Viewbox>
                                                        </Border>
                                                        <Border x:Name="BorderPenColorOrangeSoft"
                                                            Width="50"
                                                            Height="50"
                                                            Margin="4"
                                                            Background="#ea580c"
                                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="100"
                                                            MouseUp="BtnColorOrange_Click">
                                                            <Viewbox x:Name="ViewboxBtnColorOrangeSoftContent" Margin="8" Visibility="Collapsed">
                                                                <Image
                                                                    Width="24"
                                                                    Height="24"
