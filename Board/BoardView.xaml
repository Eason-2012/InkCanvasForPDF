                                    <TabControl x:Name="BoardPivotEraser"
                                        Style="{StaticResource TabControlPivotStyle}"
                                        ItemContainerStyle="{StaticResource BoardEraserPivotTabItem}"
                                        SelectionChanged="BoardPivotEraser_SelectionChanged">
                                        <TabItem Header="面积擦">
                                            <ikw:SimpleStackPanel Margin="0,4,0,4" Spacing="8">
                                                <!--  面积擦提示（照 PDF InkToolBar 同款：单行 4+4，Font 14 居中）  -->
                                                <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="覆盖笔画，区域擦除" />
                                                <!--  手掌擦除 + 笔尖模式（照 PDF InkToolBar 同款开关行；两页签各一份，靠处理器互同步）  -->
                                                <ikw:SimpleStackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="手掌擦除" />
