                                                        MinWidth="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="BoardToggleSwitchPalmErase_Toggled" />
                                                    <TextBlock Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="笔尖模式" />
                                                    <ui:ToggleSwitch x:Name="BoardToggleSwitchNibModeArea"
                                                        MinWidth="0"
                                                        IsEnabled="False"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="BoardToggleSwitchNibMode_Toggled" />
                                                </ikw:SimpleStackPanel>
