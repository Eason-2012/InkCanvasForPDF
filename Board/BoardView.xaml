                                MinWidth="250"
                                Background="{DynamicResource FloatBarBackgroundWithoutOpacity}"
                                BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="10">
                                <Border.Resources>
                                    <!--  紧凑 Pivot：与墨迹菜单同款字号资源键 + TabItemPivot 样式基类（须先于 TabControl 声明）  -->
                                    <sys:Double x:Key="PivotHeaderItemFontSize">18</sys:Double>
                                    <Style x:Key="BoardEraserPivotTabItem" TargetType="TabItem"
                                        BasedOn="{StaticResource {x:Static ui:ThemeKeys.TabItemPivotStyleKey}}">
                                        <Setter Property="Height" Value="36" />
                                    </Style>
                                    <!--  滑动清空滑块：红色圆形滑块模板（与 PDF 确认样式 1:1）  -->
                                    <ControlTemplate x:Key="BoardClearInkThumbTemplate" TargetType="Thumb">
