<UserControl
    x:Class="InkCanvasForPDF.Board.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:board="clr-namespace:InkCanvasForPDF.Board"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">
    <!--
        画板视图：整块移植自 Ink-Canvas-Artistry 4.9.4 MainWindow.xaml 画板区段（L74-2412）。
        元素名全部保留 ICA 原名，Board/MainWindow_cs/*.cs partial 直接引用。
        非全屏：由 MainWindow 放置在标题栏以下的根 Grid 内（跨 Row0+Row1）。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/BoardDrawShapeImageDictionary.xaml" />
                <ResourceDictionary Source="Resources/DrawShapeImageDictionary.xaml" />
                <ResourceDictionary Source="Resources/IconImageDictionary.xaml" />
                <ResourceDictionary Source="Resources/Styles/Light-Board.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  FloatBar 画刷不再兜底：App 级 Theme/Light-Dark.xaml 常驻且为用户指定色，画板与 PDF 同源随主题切换  -->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid
        x:Name="Main_Grid"
        Background="#01FFFFFF"
        PreviewMouseDown="Main_Grid_ShapePanelOutsideDown">
        <Grid Name="GridBackgroundCoverHolder">
            <Grid
                Name="GridBackgroundCover"
                Background="#1F1F1F"
                Visibility="Collapsed" />
        </Grid>
        <!--  // 画板 //  -->
        <board:BoardInkCanvas
            x:Name="inkCanvas"
            Background="Transparent"
            Cursor="Pen"
            EditingModeChanged="inkCanvas_EditingModeChanged"
            ForceCursor="False"
            IsManipulationEnabled="True"
            ManipulationCompleted="Main_Grid_ManipulationCompleted"
            ManipulationDelta="Main_Grid_ManipulationDelta"
            ManipulationInertiaStarting="inkCanvas_ManipulationInertiaStarting"
            ManipulationStarting="inkCanvas_ManipulationStarting"
            MouseDown="inkCanvas_MouseDown"
            MouseMove="inkCanvas_MouseMove"
            MouseUp="inkCanvas_MouseUp"
            PreviewMouseWheel="inkCanvas_PreviewMouseWheel"
            PreviewTouchDown="inkCanvas_PreviewTouchDown"
            PreviewTouchUp="inkCanvas_PreviewTouchUp"
            SelectionChanged="inkCanvas_SelectionChanged"
            StrokeCollected="inkCanvas_StrokeCollected"
            TouchDown="Main_Grid_TouchDown"
            TouchMove="inkCanvas_TouchMove"
            TouchUp="Main_Grid_TouchUp" />
        <!--  board:BoardInkCanvas = InkCanvas 子类：构造函数内装配时间笔锋的自定义 DynamicRenderer（该属性为 protected，无法外部替换）  -->
        <!--  // 选择选项窗口 //  -->
        <Grid Visibility="{Binding ElementName=inkCanvas, Path=Visibility}">
            <Grid
                Name="GridInkCanvasSelectionCover"
                Background="#01FFFFFF"
                IsManipulationEnabled="True"
                ManipulationCompleted="GridInkCanvasSelectionCover_ManipulationCompleted"
                ManipulationDelta="GridInkCanvasSelectionCover_ManipulationDelta"
                ManipulationStarting="GridInkCanvasSelectionCover_ManipulationStarting"
                MouseDown="GridInkCanvasSelectionCover_MouseDown"
                MouseMove="GridInkCanvasSelectionCover_MouseMove"
                MouseUp="GridInkCanvasSelectionCover_MouseUp"
                Opacity="0.01"
                PreviewTouchDown="GridInkCanvasSelectionCover_PreviewTouchDown"
                PreviewTouchUp="GridInkCanvasSelectionCover_PreviewTouchUp"
                Visibility="Visible" />
            <Border
                x:Name="BorderStrokeSelectionControl"
                Height="80"
                Margin="0,65,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource FloatBarBackground}"
                BorderBrush="{DynamicResource FloatBarBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding ElementName=GridInkCanvasSelectionCover, Path=Visibility}">
                <Viewbox>
                    <ikw:SimpleStackPanel
                        Height="80"
                        Orientation="Horizontal"
                        Spacing="6">
                        <ikw:SimpleStackPanel
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <Border CornerRadius="5">
                                <ToggleButton
                                    x:Name="ToggleButtonStrokeSelectionClone"
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Checked="BorderStrokeSelectionClone_Click"
                                    IsChecked="False"
                                    Unchecked="BorderStrokeSelectionClone_Click">
                                    <ikw:SimpleStackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <ui:FontIcon
                                            x:Name="IconStrokeSelectionClone"
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{Binding ElementName=IconStrokeSelectionClone, Path=Foreground}"
                                            Text="克隆模式" />
                                    </ikw:SimpleStackPanel>
                                </ToggleButton>
                            </Border>
                            <Button
                                Width="90"
                                Height="35"
                                Padding="0"
                                Background="{DynamicResource FloatBarBackground}"
                                Click="BorderStrokeSelectionCloneToBoardOrNewPage_Click">
                                <ikw:SimpleStackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="16"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="" />
                                    <TextBlock
                                        x:Name="TextSelectionCloneToNewBoard"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="衍至画板" />
                                </ikw:SimpleStackPanel>
                            </Button>
                        </ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="4">
                            <Border
                                Height="33"
                                Padding="5,0"
                                Background="{DynamicResource FloatBarBackground}"
                                CornerRadius="3">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="">
                                        <ui:FontIcon.RenderTransformOrigin>
                                            <Point X="0.5" Y="0.5" />
                                        </ui:FontIcon.RenderTransformOrigin>
                                        <ui:FontIcon.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="90" />
                                                <ScaleTransform ScaleX="1" ScaleY="-1" />
                                            </TransformGroup>
                                        </ui:FontIcon.RenderTransform>
                                    </ui:FontIcon>
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="逆旋" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnAnticlockwiseRotate15_Click">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="15°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnAnticlockwiseRotate45_Click">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="45°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnAnticlockwiseRotate90_Click">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="90°" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                            <Border
                                Height="33"
                                Padding="5,0"
                                Background="{DynamicResource FloatBarBackground}"
                                CornerRadius="3">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="">
                                        <ui:FontIcon.RenderTransformOrigin>
                                            <Point X="0.5" Y="0.5" />
                                        </ui:FontIcon.RenderTransformOrigin>
                                        <ui:FontIcon.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </ui:FontIcon.RenderTransform>
                                    </ui:FontIcon>
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="顺旋" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnClockwiseRotate15_Click">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="15°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnClockwiseRotate45_Click">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="45°" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnClockwiseRotate90_Click">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="90°" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                        </ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="2">
                            <Button
                                Width="90"
                                Height="35"
                                Padding="0"
                                Background="{DynamicResource FloatBarBackground}"
                                Click="BtnFlipHorizontal_Click">
                                <ikw:SimpleStackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <ikw:SimpleStackPanel
                                        Width="18"
                                        Height="18"
                                        Orientation="Vertical">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-18,-1,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-17,0,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="12"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="">
                                            <ui:FontIcon.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5" />
                                            </ui:FontIcon.RenderTransformOrigin>
                                            <ui:FontIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                                </TransformGroup>
                                            </ui:FontIcon.RenderTransform>
                                        </ui:FontIcon>
                                    </ikw:SimpleStackPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="水平翻转" />
                                </ikw:SimpleStackPanel>
                            </Button>
                            <Button
                                Width="90"
                                Height="35"
                                Padding="0"
                                Background="{DynamicResource FloatBarBackground}"
                                Click="BtnFlipVertical_Click">
                                <ikw:SimpleStackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <ikw:SimpleStackPanel
                                        Width="18"
                                        Height="18"
                                        Orientation="Vertical">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-19,0,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="">
                                            <ui:FontIcon.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5" />
                                            </ui:FontIcon.RenderTransformOrigin>
                                            <ui:FontIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                                </TransformGroup>
                                            </ui:FontIcon.RenderTransform>
                                        </ui:FontIcon>
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,-18,0,0"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="12"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="竖直翻转" />
                                </ikw:SimpleStackPanel>
                            </Button>
                        </ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                <Border
                                    Width="155"
                                    Height="33"
                                    Padding="5,0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource FloatBarBackground}"
                                    CornerRadius="3">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <TextBlock
                                            Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="粗细" />
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="GridPenWidthIncrease_Click">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Glyph="" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="GridPenWidthDecrease_Click">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Glyph="" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="GridPenWidthRestore_Click">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Glyph="" />
                                        </Button>
                                    </ikw:SimpleStackPanel>
                                </Border>
                                <Button
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Click="BtnStrokeSelectionSaveToImage_Click">
                                    <ikw:SimpleStackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="存为图片" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                                <Button
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Click="BorderStrokeSelectionDelete_Click">
                                    <ikw:SimpleStackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Text="删除" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                            </ikw:SimpleStackPanel>
                            <Border
                                Height="33"
                                Padding="5,0"
                                Background="{DynamicResource FloatBarBackground}"
                                CornerRadius="3">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                    <ui:FontIcon
                                        Width="18"
                                        Height="18"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="" />
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Text="颜色" />
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorBlack_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="Black"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorWhite_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="White"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorRed_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#dc2626"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorOrange_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#ea580c"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorYellow_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#eab308"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorGreen_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#16a34a"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorTeal_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#0d9488"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorBlue_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#2563eb"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                    <Button
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{DynamicResource FloatBarBackground}"
                                        Click="BtnColorPink_Click">
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="#c72ec7"
                                            BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="100" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                        </ikw:SimpleStackPanel>
                    </ikw:SimpleStackPanel>
                </Viewbox>
            </Border>
        </Grid>
        <!--  // 画板界面 //  -->
        <Grid Visibility="{Binding ElementName=GridBackgroundCoverHolder, Path=Visibility}">
            <!--  左下角  -->
            <Viewbox
                x:Name="ViewboxBlackboardLeftSide"
                Height="55"
                Margin="3,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <Viewbox.LayoutTransform>
                    <ScaleTransform x:Name="ViewboxBlackboardLeftSideScaleTransform" ScaleX="1" ScaleY="1" />
                </Viewbox.LayoutTransform>
                <Grid
                    x:Name="BlackboardLeftSide"
                    Height="55"
                    Margin="3,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Visibility="Visible">
                    <Grid.Resources>
                        <!--  定义 SolidColorBrush 资源  -->
                        <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundKey}" Color="{DynamicResource BoardBarButtonBackgroundKey}" />
                        <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}" Color="{DynamicResource BoardBarButtonBackgroundPointerOverKey}" />
                        <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}" Color="{DynamicResource BoardBarButtonButtonBackgroundPressedKey}" />
                        <!--  定义按钮样式  -->
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundKey}}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <ikw:SimpleStackPanel x:Name="BlackboardLeftBarPanel" Orientation="Horizontal">
                        <Button
                            x:Name="BtnWhiteBoardSwitchPrevious"
                            Width="60"
                            Height="55"
                            Padding="0"
                            BorderThickness="0"
                            Click="BtnWhiteBoardSwitchPrevious_Click">
                            <Border
                                Width="60"
