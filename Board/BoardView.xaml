                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="#FFFFFF"
                                                Icon="ArrowRight"
                                                IconSize="Resizable"
                                                IconVariant="Regular" />
                                        </Border>
                                    </ControlTemplate>
                                </Border.Resources>
