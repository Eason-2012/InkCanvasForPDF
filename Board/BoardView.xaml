                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="粗细" />
                                                    <Slider x:Name="BoardEraserSizeSlider"
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        IsSnapToTickEnabled="True"
                                                        Maximum="30"
                                                        Minimum="1"
                                                        TickFrequency="1"
                                                        TickPlacement="None"
                                                        Value="10"
                                                        ValueChanged="BoardEraserSizeSlider_ValueChanged"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Text="{Binding Value, ElementName=BoardEraserSizeSlider, Mode=OneWay}" />
                                                </Grid>
                                            </ikw:SimpleStackPanel>
                                        </TabItem>
                                        <TabItem Header="墨迹擦">
                                            <ikw:SimpleStackPanel Margin="0,4,0,4" Spacing="8">
                                                <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="划过笔画，整笔擦除" />
                                                <!--  手掌擦除 + 笔尖模式（与面积擦页签同款同处理器，靠重入守卫互同步）  -->
                                                <ikw:SimpleStackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="手掌擦除" />
                                                    <ui:ToggleSwitch x:Name="BoardToggleSwitchPalmEraseStroke"
                                                        MinWidth="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="BoardToggleSwitchPalmErase_Toggled" />
                                                    <TextBlock Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}" Text="笔尖模式" />
                                                    <ui:ToggleSwitch x:Name="BoardToggleSwitchNibModeStroke"
                                                        MinWidth="0"
                                                        IsEnabled="False"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="BoardToggleSwitchNibMode_Toggled" />
                                                </ikw:SimpleStackPanel>
                                            </ikw:SimpleStackPanel>
                                        </TabItem>
                                    </TabControl>
                                    <!--  滑动清空滑块（与 PDF 确认样式 1:1：轨道160×48 圆角24、滑块40 红#E8463A 左缘4、文字左对齐 64=44+20、
                                         拖动即隐藏文字、滑到底松手清空当前画板后直接回左）  -->
                                    <Border x:Name="BoardClearInkTrack"
                                        Width="160"
                                        Height="48"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource FloatBarBackgroundWithoutOpacity}"
                                        BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="24">
                                        <Grid>
                                            <TextBlock x:Name="BoardClearInkLabel"
                                                Margin="64,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="清空墨迹" />
                                            <Thumb x:Name="BoardClearInkThumb"
                                                Width="40"
                                                Height="40"
                                                Margin="4,3,0,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Focusable="True"
                                                DragCompleted="BoardClearInkThumb_DragCompleted"
                                                DragDelta="BoardClearInkThumb_DragDelta"
                                                DragStarted="BoardClearInkThumb_DragStarted"
                                                KeyDown="BoardClearInkThumb_KeyDown"
                                                Template="{StaticResource BoardClearInkThumbTemplate}" />
                                        </Grid>
                                    </Border>
                                </ikw:SimpleStackPanel>
                            </Border>
                        </Popup>
                        <Border Width="0" />
                        <Button
                            Width="60"
                            Height="55"
                            Padding="0"
                            BorderThickness="0"
                            Click="BoardDrawShape_Click">
                            <Border
                                x:Name="BoardDrawShape"
                                Width="60"
                                Height="55"
                                Background="{DynamicResource BoardBarBackground}"
                                BorderBrush="{DynamicResource BoardBarBorderBrush}"
                                BorderThickness="0,1,0.25,1">
                                <Grid Margin="5">
                                    <ikw:SimpleStackPanel
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        Orientation="Horizontal">
                                        <ui:FontIcon
                                            Width="28"
                                            Height="22"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="22"
                                            Foreground="{DynamicResource BoardBarForeground}"
                                            Glyph="&#xf158;" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Text="图形" />
                                </Grid>
                            </Border>
                        </Button>
                        <!-- 图形面板 Popup（照抄 PDF ShapePalette：Custom 放置于图形按钮正上方 8px） -->
                        <Popup
                            x:Name="BoardShapePalette"
                            Placement="Custom"
                            AllowsTransparency="True"
                            StaysOpen="True"
                            IsOpen="False"
                            PopupAnimation="None">
                            <Border
                                x:Name="BoardBorderDrawShape"
                                Background="{DynamicResource FloatBarBackgroundWithoutOpacity}"
                                BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="10">
                                <ikw:SimpleStackPanel Orientation="Vertical">
                                    <Grid Margin="14,8,10,2">
                                        <TextBlock
                                            x:Name="BoardShapeHintTextBlock"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#666666"
                                            VerticalAlignment="Center"
                                            Text="长按或右键可保持选中该图形" />
                                        <ui:FontIcon
                                            x:Name="BoardBorderDrawShapePin"
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Right"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe77a;"
                                            MouseDown="Border_MouseDown"
                                            MouseUp="SymbolIconPinBorderDrawShape_MouseUp" />
                                    </Grid>
                                    <!-- 5×5 宫格：逐字复制 PDF InkToolBar（每图形项等大单元格，末格留空） -->
                                    <UniformGrid Rows="5" Columns="5" Width="225" Height="225" Margin="10,6,10,10">
                                        <Border Tag="1" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image x:Name="ImageDrawLine"
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                Source="{DynamicResource DrawShapeImageSource.Line}" />
                                        </Border>
                                        <Border Tag="8" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image x:Name="ImageDrawDashedLine"
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                Source="{DynamicResource DrawShapeImageSource.DashedLine}" />
                                        </Border>
                                        <Border Tag="18" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image x:Name="ImageDrawDotLine"
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                Source="{DynamicResource DrawShapeImageSource.DotLine}" />
                                        </Border>
                                        <Border Tag="2" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image x:Name="ImageDrawArrow"
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                Source="{DynamicResource DrawShapeImageSource.ArrowLine}" />
                                        </Border>
                                        <Border Tag="15" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image x:Name="ImageDrawParallelLine"
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                Source="{DynamicResource DrawShapeImageSource.ParallelLine}" />
                                        </Border>
                                        <Border Tag="11" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Coordinate1}" />
                                        </Border>
                                        <Border Tag="12" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Coordinate2}" />
                                        </Border>
                                        <Border Tag="13" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Coordinate3}" />
                                        </Border>
                                        <Border Tag="14" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Coordinate4}" />
                                        </Border>
                                        <Border Tag="17" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Coordinate5}" />
                                        </Border>
                                        <Border Tag="19" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.RectangleCenter}" />
                                        </Border>
                                        <Border Tag="5" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Circle}" />
                                        </Border>
                                        <Border Tag="10" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.DashedCircle}" />
                                        </Border>
                                        <Border Tag="16" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.EllipseCenter}" />
                                        </Border>
                                        <Border Tag="23" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.EllipseCenterWithFocalPoint}" />
                                        </Border>
                                        <Border Tag="24" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Hyperbola}" />
                                        </Border>
                                        <Border Tag="25" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.HyperbolaWithFocalPoint}" />
                                        </Border>
                                        <Border Tag="20" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Parabola}" />
                                        </Border>
                                        <Border Tag="22" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                RenderTransformOrigin="0.5,0.5"
                                                Source="{DynamicResource DrawShapeImageSource.ParabolaWithFocalPoint}">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform />
                                                        <SkewTransform />
                                                        <RotateTransform Angle="90" />
                                                        <TranslateTransform />
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Border>
                                        <Border Tag="21" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image
                                                MouseDown="Image_MouseDown"
                                                MouseUp="Image_MouseUp"
                                                RenderTransformOrigin="0.5,0.5"
                                                Source="{DynamicResource DrawShapeImageSource.Parabola2}">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform />
                                                        <SkewTransform />
                                                        <RotateTransform Angle="90" />
                                                        <TranslateTransform />
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Border>
                                        <Border Tag="3" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Rectangle}" />
                                        </Border>
                                        <Border Tag="6" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Cylinder}" />
                                        </Border>
                                        <Border Tag="7" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Cone}" />
                                        </Border>
                                        <Border Tag="9" CornerRadius="5" Background="Transparent" Margin="6" Padding="2">
                                            <Image MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" Source="{DynamicResource DrawShapeImageSource.Cuboid}" />
                                        </Border>
                                    </UniformGrid>
                                </ikw:SimpleStackPanel>
                            </Border>
                        </Popup>
                        <Button
                            Width="60"
                            Height="55"
                            Padding="0"
                            BorderThickness="0"
                            Click="SymbolIconUndo_Click">
                            <Border
                                x:Name="BoardUndo"
                                Width="60"
                                Height="55"
                                Background="{DynamicResource BoardBarBackground}"
                                BorderBrush="{DynamicResource BoardBarBorderBrush}"
                                BorderThickness="0,1,0.25,1">
                                <Grid Margin="5">
                                    <ikw:SimpleStackPanel
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        Orientation="Horizontal">
                                        <ui:FontIcon
                                            Width="28"
                                            Height="22"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="22"
                                            Foreground="{DynamicResource BoardBarForeground}"
                                            Glyph="" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Text="撤销" />
                                </Grid>
                            </Border>
                        </Button>
                        <Button
                            Width="60"
                            Height="55"
                            Padding="0"
                            BorderThickness="0"
                            Click="SymbolIconRedo_Click">
                            <Border
                                x:Name="BoardRedo"
                                Width="60"
                                Height="55"
                                Background="{DynamicResource BoardBarBackground}"
                                BorderBrush="{DynamicResource BoardBarBorderBrush}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,5,5,0">
                                <Grid Margin="5">
                                    <ikw:SimpleStackPanel
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        Orientation="Horizontal">
                                        <ui:FontIcon
                                            Width="28"
                                            Height="22"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="22"
                                            Foreground="{DynamicResource BoardBarForeground}"
                                            Glyph="" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Text="重做" />
                                </Grid>
                            </Border>
                        </Button>
                    </ikw:SimpleStackPanel>
                </Grid>
            </Viewbox>
            <!--  右下角  -->
            <Viewbox
                x:Name="ViewboxBlackboardRightSide"
                Height="55"
                Margin="3,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Viewbox.LayoutTransform>
                    <ScaleTransform x:Name="ViewboxBlackboardRightSideScaleTransform" ScaleX="1" ScaleY="1" />
                </Viewbox.LayoutTransform>
                <Grid
                    x:Name="BlackboardRightSide"
                    Height="55"
                    Margin="0,0,3,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="Visible">
                    <Grid.Resources>
                        <!--  定义 SolidColorBrush 资源  -->
                        <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundKey}" Color="{DynamicResource BoardBarButtonBackgroundKey}" />
                        <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}" Color="{DynamicResource BoardBarButtonBackgroundPointerOverKey}" />
                        <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}" Color="{DynamicResource BoardBarButtonButtonBackgroundPressedKey}" />
                        <!--  定义按钮样式  -->
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundKey}}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{StaticResource {x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <ikw:SimpleStackPanel x:Name="BlackboardRightBarPanel" Orientation="Horizontal">
                        <Button
                            Width="55"
                            Height="55"
                            Margin="0,0,5,0"
                            Padding="0"
                            BorderThickness="0"
                            Click="BtnWhiteBoardAdd_Click">
                            <Border
                                Width="55"
                                Height="55"
                                Background="{DynamicResource BoardBarBackground}"
                                BorderBrush="{DynamicResource BoardBarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <Grid Margin="5">
                                    <!--  居中微调：加页图标在本按钮内左偏 2px（ICA 原生缺陷），用 4px 左外边距推回中心  -->
                                    <ui:FontIcon
                                        x:Name="BtnBoardAddPage"
                                        Width="26"
                                        Height="26"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Top"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="24"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Glyph=""
                                        IsEnabled="True"
                                        IsEnabledChanged="Element_IsEnabledChanged" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Opacity="{Binding ElementName=BtnBoardAddPage, Path=Opacity}"
                                        Text="加页" />
                                </Grid>
                            </Border>
                        </Button>
                        <Button
                            Width="60"
                            Height="55"
                            Padding="0"
                            BorderThickness="0"
                            Click="BtnWhiteBoardSwitchPrevious_Click"
                            IsEnabled="{Binding ElementName=BtnWhiteBoardSwitchPrevious, Path=IsEnabled}"
                            Opacity="{Binding ElementName=BtnWhiteBoardSwitchPrevious, Path=Opacity}">
                            <Border
                                Width="60"
                                Height="55"
                                Background="{DynamicResource BoardBarBackground}"
                                BorderBrush="{DynamicResource BoardBarBorderBrush}"
                                BorderThickness="1,1,0.25,1"
                                CornerRadius="3,0,0,3">
                                <Grid Margin="5">
                                    <ui:FontIcon
                                        Width="26"
                                        Height="26"
                                        VerticalAlignment="Top"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="24"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Glyph="" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Text="上一页" />
                                </Grid>
                            </Border>
                        </Button>
                        <Border
                            Width="58"
                            Height="55"
                            Background="{DynamicResource BoardBarBackground}"
                            BorderBrush="{DynamicResource BoardBarBorderBrush}"
                            BorderThickness="0,1,0.25,1">
                            <Grid Margin="0,5">
                                <ikw:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="0,4,0,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Text="{Binding ElementName=TextBlockWhiteBoardIndexInfo, Path=Text}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Text="页码" />
                                </ikw:SimpleStackPanel>
                            </Grid>
                        </Border>
                        <Button
                            Width="60"
                            Height="55"
                            Padding="0"
                            BorderThickness="0"
                            Click="BtnWhiteBoardSwitchNext_Click">
                            <Border
                                Width="60"
                                Height="55"
                                Background="{DynamicResource BoardBarBackground}"
                                BorderBrush="{DynamicResource BoardBarBorderBrush}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,5,5,0">
                                <Grid Margin="5">
                                    <ui:FontIcon
                                        Width="{Binding ElementName=BoardLeftPannelNextPage1, Path=Width}"
                                        Height="26"
                                        VerticalAlignment="Top"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="24"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Glyph=""
                                        Opacity="{Binding ElementName=BoardLeftPannelNextPage1, Path=Opacity}" />
                                    <ui:FontIcon
                                        Width="{Binding ElementName=BoardLeftPannelNextPage2, Path=Width}"
                                        Height="26"
                                        VerticalAlignment="Top"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="24"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Glyph=""
                                        Opacity="{Binding ElementName=BoardLeftPannelNextPage1, Path=Opacity}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="12"
                                        Foreground="{DynamicResource BoardBarForeground}"
                                        Opacity="{Binding ElementName=BoardLeftPannelNextPage1, Path=Opacity}"
                                        Text="{Binding ElementName=BoardLeftPannelNextPageTextBlock, Path=Text}" />
                                </Grid>
                            </Border>
                        </Button>
                    </ikw:SimpleStackPanel>
                </Grid>
            </Viewbox>
        </Grid>
        <!--  形状面板自动隐藏开关（ICA 浮动栏元素，画板代码引用，常开且隐藏）  -->
        <ui:ToggleSwitch
            x:Name="ToggleSwitchDrawShapeBorderAutoHide"
            IsOn="True"
            Visibility="Collapsed" />
        <Border x:Name="BtnPPTSlideShowEnd" Visibility="Collapsed" />
        <Grid x:Name="GridNotifications" Visibility="Collapsed" />
    </Grid>
</UserControl>
